# Pinned inputs for cloud-init and Bicep. Confirmed from Scylla docs on 2026-11-05
# unless a line says otherwise. Image URN was not listed with `az vm image list`
# in this environment; confirm on the subscription before the first live create.

UBUNTU_PUBLISHER=Canonical
UBUNTU_OFFER=ubuntu-24_04-lts
UBUNTU_SKU=server
UBUNTU_VERSION=latest

# https://docs.scylladb.com/manual/stable/getting-started/install-scylla/install-on-linux.html
SCYLLA_LIST_URL=https://downloads.scylladb.com/deb/debian/scylla-2026.3.list
SCYLLA_GPG_KEY=c503c686b007f39e

# https://manager.docs.scylladb.com/stable/install-scylla-manager.html
MANAGER_LIST_URL=https://downloads.scylladb.com/deb/debian/scylladb-manager-3.13.list
MANAGER_GPG_KEY=c503c686b007f39e

# docker: assignment shape. package: apt install, used if MANAGER_INSTALL=package.
MANAGER_INSTALL=docker
# Docker Hub has no :3.13 tag. The 3.13 release is published as 3.13.0.
MANAGER_IMAGE=scylladb/scylla-manager:3.13.0
SCYLLA_IMAGE=scylladb/scylla:2026.3

# https://docs.scylladb.com/manual/stable/reference/configuration-parameters.html
# replace_address_first_boot is deprecated and unsupported.
SCYLLA_REPLACE_FLAG=replace_node_first_boot

# Image tags shipped inside scylla-monitoring 4.16.3. start-all.sh pulls them.
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
LOKI_IMAGE=grafana/loki:3.7.8

DATA_VM_SIZE=Standard_D4ds_v6
OPS_VM_SIZE=Standard_D4s_v6
DATA_DISK_GB=256
OS_DISK_DATA_GB=32
OS_DISK_OPS_GB=64
AZURE_ZONE=1

MONITORING_REPO=https://github.com/scylladb/scylla-monitoring.git
# 4.16.3 is the stable release whose prebuilt dashboards include ver_2026.3.
MONITORING_REF=4.16.3
MONITORING_SCYLLA_VERSION=2026.3
# That release names the Manager 3.x dashboards "3". Those dashboards cover Manager 3.13.
MONITORING_MANAGER_VERSION=3
